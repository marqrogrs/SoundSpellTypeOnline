{
  "name": "sound-spell-type-online",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "overrides": {
    "immutable": "3.8.3",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "@ardatan/relay-compiler": {
      "immutable": "3.8.3"
    }
  },
  "dependencies": {
    "@graphql-codegen/import-types-preset": "^4.0.0",
    "@material-ui/core": "^4.11.0",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "^4.0.0-alpha.56",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^8.2.0",
    "firebase": "^12.11.0",
    "formik": "^2.2.1",
    "graphql": "^15.3.0",
    "is-binary-path": "^3.0.0",
    "lodash": "^4.17.20",
    "mixin-deep": "^2.0.1",
    "notistack": "^1.0.1",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-keyboard-event-handler": "^1.5.4",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "react-simple-keyboard": "^2.3.97",
    "rollup-plugin-terser": "^7.0.2",
    "speak-tts": "^2.0.8",
    "sweetalert": "^2.1.2",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "deploy:functions": "./deploy-functions.sh",
    "deploy:web-app": "./scripts/deploy-web-app.sh",
    "start": "react-scripts start",
    "start:stable": "BROWSER=none DISABLE_ESLINT_PLUGIN=true TSC_COMPILE_ON_ERROR=true react-scripts start",
    "start:preview": "node scripts/preview-dev-server.js",
    "start:static": "python3 -m http.server 3000 -d build",
    "build": "DISABLE_FORK_TS_CHECKER=true react-scripts build",
    "build:fast": "GENERATE_SOURCEMAP=false CI=true DISABLE_FORK_TS_CHECKER=true react-scripts build",
    "analyze:build": "GENERATE_SOURCEMAP=true CI=true DISABLE_FORK_TS_CHECKER=true react-scripts build && node scripts/analyze-bundle.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "build:wiktionary": "node scripts/buildWiktionaryDefinitions.js",
    "build:wiktionary:full": "node scripts/buildWiktionaryDefinitions.js --seed-words=data/words.json",
    "build:wiktionary:dump": "node scripts/buildWiktionaryDefinitionsFromDump.js --dump=data/enwiktionary-english.jsonl --words=data/words.json --out=public/wiktionary-definitions.json --missing=data/wiktionary-missing.json",
    "build:wiktionary:wikipedia": "node scripts/enrichDefinitionsWithWikipedia.js --words=data/words.json --in=public/wiktionary-definitions.json --missing=data/wiktionary-missing.json --out=public/wiktionary-definitions.json --report=data/wiktionary-missing.json",
    "build:wiktionary:wikipedia:misspellings": "node scripts/enrichDefinitionsWithWikipedia.js --words=data/words.json --in=public/wiktionary-definitions.json --missing=data/wiktionary-missing.json --out=public/wiktionary-definitions.json --report=data/wiktionary-missing.json --with-misspellings",
    "build:wiktionary:misspellings:csv": "node scripts/exportMisspellingSuggestionsCsv.js --in=data/wiktionary-missing.json --out=data/wiktionary-misspelling-suggestions.csv --pairs-out=data/wiktionary-misspelling-pairs.csv",
    "build:wiktionary:misspellings:pairs": "node scripts/exportMisspellingSuggestionsCsv.js --in=data/wiktionary-missing.json --pairs-out=data/wiktionary-misspelling-pairs.csv",
    "build:wiktionary:hybrid": "npm run build:wiktionary:dump && npm run build:wiktionary:wikipedia",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "patch-package",
    "codegen": "graphql-codegen --config codegen.yml",
    "migrate:remove-keyboard:dry-run": "npm --prefix functions run migrate:remove-keyboard:dry-run",
    "migrate:remove-keyboard:apply": "npm --prefix functions run migrate:remove-keyboard:apply",
    "migrate:remove-keyboard:rollback": "npm --prefix functions run migrate:remove-keyboard:rollback"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/introspection": "^1.16.3",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-codegen/typescript-react-apollo": "^4.4.1",
    "patch-package": "^8.0.0",
    "simulate-event": "^1.4.0"
  }
}
